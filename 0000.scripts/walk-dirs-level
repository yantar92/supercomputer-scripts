# Usage: walk-dirs-level N command args...
LEVEL=$1
shift # pop $1, leaving the rest in $*
find ./ -mindepth $LEVEL -maxdepth $LEVEL -type d | sort |\
    while read x; do
	# skip backups generated by gorun
	echo "$x" | grep -E "[0-9]{4}_[0-9]{2}+_[0-9]{2}+[_T][0-9]{2}_[0-9]{2}_[0-9]{2}$" >/dev/null && echo "Skipping: $x" && continue
        # skip .dirs
        echo "$(basename $x)" | grep -E "^\." >/dev/null && echo "Skipping: $x" && continue
	prev="$(pwd)"
	cd "$x"
	echo "Enetering: $x"
	$*
	cd "$prev"
    done
